# Application Configuration
APP_TITLE=My API
APP_VERSION=1.0.0
DEBUG=False
LOG_LEVEL=INFO

# OIDC Configuration
OIDC_DISCOVERY_URL=https://auth.example.com/.well-known/openid-configuration
OIDC_ISSUER=https://auth.example.com/realms/organization
OIDC_CLIENT_ID=my-client-id
OIDC_AUDIENCE=account
SWAGGER_CLIENT_ID=my-swagger-client-id
OIDC_USER_NAME_CLAIM=preferred_username
OIDC_USER_ID_CLAIM=company

# CORS Configuration
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8080
TOKEN_ALGORITHMS=RS256

# Database Configuration
# DB_TYPE can be 'postgresql', 'sqlite', or 'mysql' (default: postgresql)
# Use sqlite for quick development without PostgreSQL setup
DB_TYPE=postgresql

# PostgreSQL Configuration (used when DB_TYPE=postgresql)
DB_USER=postgres
DB_PASS=postgres
DB_HOST=localhost
DB_PORT=5432
DB_NAME=public
DB_SCHEMA=public

# SQLite Configuration (used when DB_TYPE=sqlite)
# Path to SQLite database file (relative to project root or absolute path)
SQLITE_DB_PATH=./data/app.db

# MySQL/MariaDB Configuration (used when DB_TYPE=mysql)
# Uses the same variables as PostgreSQL (except DB_SCHEMA which is not supported)
# DB_USER=root
# DB_PASS=secret
# DB_HOST=localhost
# DB_PORT=3306
# DB_NAME=myapp

# Database Connection Pool Settings
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
DB_POOL_RECYCLE=3600
DB_POOL_TIMEOUT=30
ECHO_SQL=False

# ============================================
# Middleware Configuration
# ============================================

# Request ID Middleware
# Adds unique request ID to each request for distributed tracing
ENABLE_REQUEST_ID_MIDDLEWARE=True

# Security Headers Middleware
# Adds OWASP-compliant security headers to all responses
ENABLE_SECURITY_HEADERS_MIDDLEWARE=True

# Logging Middleware
# Logs all requests and responses with timing information
ENABLE_LOGGING_MIDDLEWARE=True

# Error Handling Middleware
# Catches unhandled exceptions and returns safe error responses
ENABLE_ERROR_HANDLING_MIDDLEWARE=True

# Rate Limiting Middleware
# Protects against abuse and DoS attacks using slowapi
# Note: Disabled by default. Enable in production with appropriate limits.
ENABLE_RATE_LIMIT_MIDDLEWARE=False

# Rate Limiting Configuration (using slowapi)
# Maximum requests allowed per IP address per minute
RATE_LIMIT_PER_MINUTE=60

# Maximum requests allowed per IP address per hour
RATE_LIMIT_PER_HOUR=1000

# Rate Limiter Backend: 'memory' or 'redis'
# Use 'memory' for single-instance deployments (default)
# Use 'redis' for distributed/multi-instance deployments
RATE_LIMITER_BACKEND=memory

# Redis URL for distributed rate limiting (required when RATE_LIMITER_BACKEND=redis)
# Install redis support: pip install fastapi_otel_common[redis]
REDIS_URL=redis://localhost:6379

# ============================================
# OpenTelemetry Configuration
# ============================================

# Enable/disable OpenTelemetry instrumentation
# When enabled, FastAPI app is automatically instrumented with OpenTelemetry
ENABLE_OTEL_INSTRUMENTATION=True

# Enable/disable OpenTelemetry Metrics
# When enabled, HTTP request metrics are automatically collected and exported
ENABLE_OTEL_METRICS=True

# Metrics export interval in milliseconds (default: 60000 = 1 minute)
OTEL_METRIC_EXPORT_INTERVAL=60000

# Metrics export timeout in milliseconds (default: 5000 = 5 seconds)
# Prevents shutdown hangs when OTLP endpoint is unavailable or slow
OTEL_METRIC_EXPORT_TIMEOUT=5000

# OpenTelemetry Service Configuration
SERVICE_NAME=my-api
SERVICE_VERSION=1.0.0

# OTLP Exporter Endpoint
# Endpoint for OpenTelemetry data export (e.g., Jaeger, OTLP Collector)
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
