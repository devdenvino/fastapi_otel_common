# Application Configuration
APP_TITLE=My API
APP_VERSION=1.0.0
DEBUG=False
LOG_LEVEL=INFO

# OIDC Configuration
OIDC_DISCOVERY_URL=https://auth.example.com/.well-known/openid-configuration
OIDC_ISSUER=https://auth.example.com/realms/organization
OIDC_CLIENT_ID=my-client-id
OIDC_AUDIENCE=account
SWAGGER_CLIENT_ID=my-swagger-client-id
OIDC_USER_NAME_CLAIM=preferred_username
OIDC_USER_ID_CLAIM=company

# CORS Configuration
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8080
TOKEN_ALGORITHMS=RS256

# Database Configuration
DB_USER=postgres
DB_PASS=postgres
DB_HOST=localhost
DB_PORT=5432
DB_NAME=public
DB_SCHEMA=public

# Database Connection Pool Settings
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
DB_POOL_RECYCLE=3600
DB_POOL_TIMEOUT=30
ECHO_SQL=False

# ============================================
# Middleware Configuration
# ============================================

# Request ID Middleware
# Adds unique request ID to each request for distributed tracing
ENABLE_REQUEST_ID_MIDDLEWARE=True

# Security Headers Middleware
# Adds OWASP-compliant security headers to all responses
ENABLE_SECURITY_HEADERS_MIDDLEWARE=True

# Logging Middleware
# Logs all requests and responses with timing information
ENABLE_LOGGING_MIDDLEWARE=True

# Error Handling Middleware
# Catches unhandled exceptions and returns safe error responses
ENABLE_ERROR_HANDLING_MIDDLEWARE=True

# Rate Limiting Middleware
# Protects against abuse and DoS attacks using slowapi
# Note: Disabled by default. Enable in production with appropriate limits.
ENABLE_RATE_LIMIT_MIDDLEWARE=False

# Rate Limiting Configuration (using slowapi)
# Maximum requests allowed per IP address per minute
RATE_LIMIT_PER_MINUTE=60

# Maximum requests allowed per IP address per hour
RATE_LIMIT_PER_HOUR=1000
